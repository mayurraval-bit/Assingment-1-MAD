<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for notifications and reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_splash_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_splash_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stuudy_Planner">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Stuudy_Planner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dashboard / Home Screen -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- All Tasks Screen -->
        <activity
            android:name=".ui.TasksActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Task Screen -->
        <activity
            android:name=".ui.AddTaskActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Edit Task Screen -->
        <activity
            android:name=".ui.EditTaskActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Progress Screen -->
        <activity
            android:name=".ui.ProgressActivity"
            android:exported="false" />

        <!-- Alarm/Reminder Receiver -->
        <receiver
            android:name=".receiver.ReminderReceiver"
            android:enabled="true"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>